generator client {
  provider            = "prisma-client"
  output              = "../src/database/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bar", "treasury", "directory"]
}

enum ProductCategory {
  BEER
  SOFT_DRINK
  SPIRIT
  WINE

  @@schema("bar")
}

model Product {
  id                  String               @id @db.Uuid
  associationId       String?              @map("association_id") @db.Uuid
  name                String
  category            ProductCategory
  stockUnit           String               @map("stock_unit")
  associationProducts AssociationProduct[]
  saleItems           SaleItem[]

  @@index([associationId])
  @@map("products")
  @@schema("bar")
}

model AssociationProduct {
  associationId String  @map("association_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  isActive      Boolean @map("is_active")
  product       Product @relation(fields: [productId], references: [id])

  @@id([associationId, productId])
  @@map("association_products")
  @@schema("bar")
}

model SaleItem {
  id               String  @id @db.Uuid
  associationId    String  @map("association_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  name             String
  consumedQuantity Decimal @map("consumed_quantity") @db.Decimal(12, 4)
  basePriceCents   Int?    @map("base_price_cents")
  isActive         Boolean @map("is_active")
  product          Product @relation(fields: [productId], references: [id])

  @@index([associationId])
  @@map("sale_items")
  @@schema("bar")
}
