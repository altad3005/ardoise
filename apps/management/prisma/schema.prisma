generator client {
  provider            = "prisma-client"
  output              = "../src/database/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bar", "treasury", "directory"]
}

enum ProductCategory {
  PILSNER
  SPECIALTY_BEER
  SOFT_DRINK
  SPIRIT
  WINE

  @@schema("bar")
}

model Product {
  id                  String               @id @db.Uuid
  associationId       String?              @map("association_id") @db.Uuid
  name                String
  category            ProductCategory
  stockUnit           String               @map("stock_unit")
  associationProducts AssociationProduct[]
  packagings          Packaging[]
  saleItems           SaleItem[]

  @@index([associationId])
  @@map("products")
  @@schema("bar")
}

model AssociationProduct {
  associationId String  @map("association_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  isActive      Boolean @map("is_active")
  product       Product @relation(fields: [productId], references: [id])

  @@id([associationId, productId])
  @@map("association_products")
  @@schema("bar")
}

model Packaging {
  id            String  @id @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  associationId String? @map("association_id") @db.Uuid
  label         String
  unitCount     Decimal @map("unit_count") @db.Decimal(12, 4)
  product       Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("packagings")
  @@schema("bar")
}

model SaleItem {
  id               String   @id @db.Uuid
  associationId    String   @map("association_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  name             String
  consumedQuantity Decimal? @map("consumed_quantity") @db.Decimal(12, 4)
  basePriceCents   Int?     @map("base_price_cents")
  isActive         Boolean  @map("is_active")
  menuPosition     Int?     @map("menu_position")
  product          Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([associationId, menuPosition])
  @@index([associationId])
  @@map("sale_items")
  @@schema("bar")
}

enum AccountType {
  BANK
  CASH

  @@schema("treasury")
}

model Account {
  id                  String             @id @db.Uuid
  associationId       String             @map("association_id") @db.Uuid
  name                String
  type                AccountType
  openingBalanceCents Int                @map("opening_balance_cents")
  isActive            Boolean            @default(true) @map("is_active")
  settingsAsCash      TreasurySettings[]

  @@unique([associationId, name])
  @@map("accounts")
  @@schema("treasury")
}

model ProjectCategory {
  id            String    @id @db.Uuid
  associationId String    @map("association_id") @db.Uuid
  name          String
  projects      Project[]

  @@unique([associationId, name])
  @@map("project_categories")
  @@schema("treasury")
}

model Project {
  id                String             @id @db.Uuid
  associationId     String             @map("association_id") @db.Uuid
  categoryId        String             @map("category_id") @db.Uuid
  name              String
  isActive          Boolean            @default(true) @map("is_active")
  category          ProjectCategory    @relation(fields: [categoryId], references: [id])
  settingsAsDefault TreasurySettings[] @relation("DefaultProject")
  settingsAsStock   TreasurySettings[] @relation("StockProject")

  @@unique([associationId, name])
  @@index([categoryId])
  @@map("projects")
  @@schema("treasury")
}

model TreasurySettings {
  associationId        String   @id @map("association_id") @db.Uuid
  defaultProjectId     String?  @map("default_project_id") @db.Uuid
  stockProjectId       String?  @map("stock_project_id") @db.Uuid
  defaultCashAccountId String?  @map("default_cash_account_id") @db.Uuid
  defaultProject       Project? @relation("DefaultProject", fields: [defaultProjectId], references: [id], onDelete: Restrict)
  stockProject         Project? @relation("StockProject", fields: [stockProjectId], references: [id], onDelete: Restrict)
  defaultCashAccount   Account? @relation(fields: [defaultCashAccountId], references: [id], onDelete: Restrict)

  @@map("treasury_settings")
  @@schema("treasury")
}
