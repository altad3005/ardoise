# Copy to the server (or paste into your hosting panel) and fill in.

# Required
POSTGRES_PASSWORD=change-me

# Image version to run: a release number such as 0.1.0, or latest
ARDOISE_VERSION=latest

# Registry hosting the images
IMAGE_REGISTRY=ghcr.io/altad3005

# Standalone server only: public domain name, Caddy then obtains the HTTPS certificate.
# Behind a reverse proxy (Dokploy, Coolify, Traefik...), leave the default :80.
SITE_ADDRESS=:80
